rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rootPath() {
      return /databases/$(database)/documents/config/adminRoot;
    }

    function legacyTeacher() {
      return signedIn()
        && request.auth.token.email == 'andy.wbowo@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && !exists(rootPath());
    }

    function mainAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(rootPath())
        && get(rootPath()).data.uid == request.auth.uid;
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function teacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(staffPath())
        && get(staffPath()).data.role == 'teacher'
        && get(staffPath()).data.active == true;
    }

    function admin() {
      return legacyTeacher() || mainAdmin() || teacher();
    }

    function linkedStudent(studentId) {
      let grant = /databases/$(database)/documents/studentBrowserAccess/$(request.auth.uid)/students/$(studentId);
      let key = /databases/$(database)/documents/studentAccessKeys/$(studentId);
      return exists(grant) && exists(key) && get(grant).data.code == get(key).data.code;
    }

    function studentAccess(studentId) {
      return signedIn() && (get(/databases/$(database)/documents/students/$(studentId)).data.ownerUid == request.auth.uid
        || linkedStudent(studentId));
    }

    // Secret codes grant access to one existing record, without changing its owner or answers.
    match /studentAccessKeys/{studentId} {
      allow get: if admin() || studentAccess(studentId);
      allow list: if admin();
      allow create: if (admin() || studentAccess(studentId))
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code.matches('[a-f0-9]{32}');
      allow update: if admin()
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code.matches('[a-f0-9]{32}');
      allow delete: if admin();
    }

    match /studentAccessCodes/{code} {
      allow get: if admin() || (signedIn()
        && code.matches('[a-f0-9]{32}')
        && exists(/databases/$(database)/documents/studentAccessKeys/$(resource.data.studentId))
        && get(/databases/$(database)/documents/studentAccessKeys/$(resource.data.studentId)).data.code == code);
      allow list: if admin();
      allow create: if code.matches('[a-f0-9]{32}')
        && request.resource.data.keys().hasOnly(['studentId'])
        && request.resource.data.studentId is string
        && (admin() || studentAccess(request.resource.data.studentId))
        && getAfter(/databases/$(database)/documents/studentAccessKeys/$(request.resource.data.studentId)).data.code == code;
      allow update: if admin()
        && code.matches('[a-f0-9]{32}')
        && request.resource.data.keys().hasOnly(['studentId'])
        && request.resource.data.studentId is string
        && request.resource.data.studentId == resource.data.studentId
        && getAfter(/databases/$(database)/documents/studentAccessKeys/$(request.resource.data.studentId)).data.code == code;
      allow delete: if admin();
    }

    match /studentBrowserAccess/{uid}/students/{studentId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code.matches('[a-f0-9]{32}')
        && exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/studentAccessCodes/$(request.resource.data.code)).data.studentId == studentId
        && get(/databases/$(database)/documents/studentAccessKeys/$(studentId)).data.code == request.resource.data.code;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /config/adminRoot {
      allow get: if true;
      allow list: if false;
      // The existing Google admin can create the first admin account once.
      // After creation, its old Google access ends automatically.
      allow create: if legacyTeacher()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'email'])
        && request.resource.data.uid is string
        && request.resource.data.username == 'admin'
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    match /staff/{staffId} {
      allow get: if mainAdmin() || (signedIn() && request.auth.uid == staffId);
      allow list: if mainAdmin();
      allow create: if mainAdmin()
        && request.resource.data.keys().hasOnly(['username', 'email', 'role', 'active'])
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.role == 'teacher'
        && request.resource.data.active == true;
      allow update: if mainAdmin()
        && resource.data.role == 'teacher'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /staffUsernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if mainAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid is string
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    match /settings/public {
      allow get: if true;
      allow list: if false;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['classNames', 'allowEarlyPhaseTwo'])
        && request.resource.data.classNames is list
        && request.resource.data.classNames.size() > 0
        && request.resource.data.allowEarlyPhaseTwo is bool;
      allow delete: if false;
    }

    // No credentials are stored here; students need this server setting for atomic enqueue.
    match /settings/driveBackup {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['folderUrl', 'enabled'])
        && request.resource.data.folderUrl is string
        && request.resource.data.folderUrl.matches('https://drive[.]google[.]com/drive/folders/[A-Za-z0-9_-]{8,100}')
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }

    match /settings/driveBackupWorker {
      allow get: if admin();
      allow list, create, update, delete: if false; // Written by the authorized Google server worker through IAM.
    }

    function completedThrough(journey, milestone) {
      return journey.stages['1'].completed == true
        && journey.stages['2'].completed == true
        && journey.stages['3'].completed == true
        && journey.stages['4'].completed == true
        && (milestone == 4 || (journey.stages['5'].completed == true
          && journey.stages['6'].completed == true
          && journey.stages['7'].completed == true
          && journey.stages['8'].completed == true));
    }

    match /driveBackupJobs/{jobId} {
      allow get, list: if admin();
      allow create: if signedIn()
        && jobId.matches('[a-f0-9-]{36}')
        && request.resource.data.keys().hasOnly(['ownerUid', 'studentId', 'milestone', 'status', 'createdAt', 'revision'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.milestone in [4, 8]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/settings/driveBackup).data.enabled == true
        && (getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.ownerUid == request.auth.uid
          || linkedStudent(request.resource.data.studentId))
        && request.resource.data.revision == getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.journey.updatedAt
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.journey.updatedAt != request.resource.data.revision
        && completedThrough(getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.journey, request.resource.data.milestone);
      allow update, delete: if false; // Worker-only status; clients cannot claim a successful backup.
    }

    match /students/{studentId} {
      allow get, list: if admin() ||
        (signedIn() && (resource.data.ownerUid == request.auth.uid || linkedStudent(studentId)));

      // Teachers/admins may recreate student documents from an explicitly selected backup.
      allow create: if ((signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.ownerUid == request.auth.uid) || admin())
        && request.resource.data.keys().hasOnly(['ownerUid', 'student', 'journey'])
        && request.resource.data.ownerUid is string
        && request.resource.data.student is map
        && request.resource.data.journey is map
        && request.resource.data.student.id == studentId
        && request.resource.data.journey.studentId == studentId;

      allow update: if admin() ||
        (signedIn()
          && (resource.data.ownerUid == request.auth.uid || linkedStudent(studentId))
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.student == resource.data.student
          && request.resource.data.journey.studentId == studentId);

      allow delete: if admin();
    }
  }
}

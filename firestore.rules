rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rootPath() {
      return /databases/$(database)/documents/config/adminRoot;
    }

    function legacyTeacher() {
      return signedIn()
        && request.auth.token.email == 'andy.wbowo@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && !exists(rootPath());
    }

    function mainAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(rootPath())
        && get(rootPath()).data.uid == request.auth.uid;
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function teacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(staffPath())
        && get(staffPath()).data.role == 'teacher'
        && get(staffPath()).data.active == true;
    }

    function admin() {
      return legacyTeacher() || mainAdmin() || teacher();
    }

    match /config/adminRoot {
      allow get: if true;
      allow list: if false;
      // The existing Google admin can create the first admin account once.
      // After creation, its old Google access ends automatically.
      allow create: if legacyTeacher()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'email'])
        && request.resource.data.uid is string
        && request.resource.data.username == 'admin'
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    match /staff/{staffId} {
      allow get: if mainAdmin() || (signedIn() && request.auth.uid == staffId);
      allow list: if mainAdmin();
      allow create: if mainAdmin()
        && request.resource.data.keys().hasOnly(['username', 'email', 'role', 'active'])
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.role == 'teacher'
        && request.resource.data.active == true;
      allow update: if mainAdmin()
        && resource.data.role == 'teacher'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /staffUsernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if mainAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid is string
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    match /settings/public {
      allow get: if true;
      allow list: if false;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['classNames', 'allowEarlyPhaseTwo'])
        && request.resource.data.classNames is list
        && request.resource.data.classNames.size() > 0
        && request.resource.data.allowEarlyPhaseTwo is bool;
      allow delete: if false;
    }

    match /students/{studentId} {
      allow get, list: if admin() ||
        (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['ownerUid', 'student', 'journey'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.student.id == studentId
        && request.resource.data.journey.studentId == studentId;

      allow update: if admin() ||
        (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.student == resource.data.student
          && request.resource.data.journey.studentId == studentId);

      allow delete: if admin();
    }
  }
}
